  EXCEPTION WHEN OTHERS THEN p_total := 0; MENSAJE := 'Error'; END GET_PRODUCCION_ACTIVA_PJM;

  PROCEDURE GET_PRODUCCION_ANULADA_PJM(p_total OUT NUMBER, MENSAJE OUT VARCHAR2) AS
