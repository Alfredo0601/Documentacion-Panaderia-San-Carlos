  PROCEDURE INS_DETALLE_PRODUCCION_PJM(P_ID_PRODUCCION NUMBER, P_ID_PRODUCTO NUMBER, P_CANTIDAD_PRODUCIDA NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id NUMBER; v_necesario NUMBER; v_recetas_count NUMBER;
  BEGIN
    SELECT COUNT(*) INTO v_recetas_count FROM RECETA_PJM WHERE ID_PRODUCTO = P_ID_PRODUCTO AND ESTADO = 1;
    IF v_recetas_count > 0 THEN
      FOR rec IN (SELECT r.ID_INSUMO, r.CANTIDAD, i.NOMBRE, i.STOCK FROM RECETA_PJM r JOIN PRODUCTO_PJM i ON i.ID_PRODUCTO = r.ID_INSUMO WHERE r.ID_PRODUCTO = P_ID_PRODUCTO AND r.ESTADO = 1) LOOP
        v_necesario := rec.CANTIDAD * P_CANTIDAD_PRODUCIDA;
        IF rec.STOCK < v_necesario THEN 
            ID_SALIDA := -1; 
            MENSAJE := 'No hay suficiente ' || rec.NOMBRE || ' (necesario: ' || v_necesario || ', disponible: ' || rec.STOCK || ')'; 
            RETURN; 
        END IF;
      END LOOP;
    END IF;
    SELECT SQ_DETALLE_PRODUCCION_PJM.NEXTVAL INTO v_id FROM DUAL;
    INSERT INTO DETALLE_PRODUCCION_PJM VALUES (v_id, P_ID_PRODUCCION, P_ID_PRODUCTO, P_CANTIDAD_PRODUCIDA, 1);
    UPDATE PRODUCTO_PJM SET STOCK = STOCK + P_CANTIDAD_PRODUCIDA WHERE ID_PRODUCTO = P_ID_PRODUCTO;
    IF v_recetas_count > 0 THEN
      FOR rec IN (SELECT ID_INSUMO, CANTIDAD FROM RECETA_PJM WHERE ID_PRODUCTO = P_ID_PRODUCTO AND ESTADO = 1) LOOP
        UPDATE PRODUCTO_PJM SET STOCK = STOCK - (rec.CANTIDAD * P_CANTIDAD_PRODUCIDA) WHERE ID_PRODUCTO = rec.ID_INSUMO;
      END LOOP;
    END IF;
    COMMIT; ID_SALIDA := v_id; MENSAJE := 'Producción registrada. Insumos descontados.';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END INS_DETALLE_PRODUCCION_PJM;

  PROCEDURE ANULAR_DETALLE_PRODUCCION_PJM(P_ID_DETALLE_PRODUCCION NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id_producto NUMBER; v_cantidad NUMBER; v_count NUMBER;
  BEGIN
    SELECT COUNT(*) INTO v_count FROM DETALLE_PRODUCCION_PJM WHERE ID_DETALLE_PRODUCCION = P_ID_DETALLE_PRODUCCION AND ESTADO = 1;
    IF v_count = 0 THEN ID_SALIDA := -1; MENSAJE := 'El detalle no existe o ya está anulado'; RETURN; END IF;
    SELECT ID_PRODUCTO, CANTIDAD_PRODUCIDA INTO v_id_producto, v_cantidad FROM DETALLE_PRODUCCION_PJM WHERE ID_DETALLE_PRODUCCION = P_ID_DETALLE_PRODUCCION;
    UPDATE PRODUCTO_PJM SET STOCK = STOCK - v_cantidad WHERE ID_PRODUCTO = v_id_producto;
    FOR rec IN (SELECT ID_INSUMO, CANTIDAD FROM RECETA_PJM WHERE ID_PRODUCTO = v_id_producto AND ESTADO = 1) LOOP
      UPDATE PRODUCTO_PJM SET STOCK = STOCK + (rec.CANTIDAD * v_cantidad) WHERE ID_PRODUCTO = rec.ID_INSUMO;
    END LOOP;
    UPDATE DETALLE_PRODUCCION_PJM SET ESTADO = 0 WHERE ID_DETALLE_PRODUCCION = P_ID_DETALLE_PRODUCCION;
    COMMIT; ID_SALIDA := 1; MENSAJE := 'Detalle anulado. Insumos devueltos.';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END ANULAR_DETALLE_PRODUCCION_PJM;

  PROCEDURE ANULAR_PRODUCCION_PJM(P_ID_PRODUCCION NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_count NUMBER;
  BEGIN
    SELECT COUNT(*) INTO v_count FROM PRODUCCION_PJM WHERE ID_PRODUCCION = P_ID_PRODUCCION AND ESTADO = 1;
    IF v_count = 0 THEN ID_SALIDA := -1; MENSAJE := 'La producción no existe o ya está anulada'; RETURN; END IF;
    FOR det IN (SELECT ID_DETALLE_PRODUCCION, ID_PRODUCTO, CANTIDAD_PRODUCIDA FROM DETALLE_PRODUCCION_PJM WHERE ID_PRODUCCION = P_ID_PRODUCCION AND ESTADO = 1) LOOP
      UPDATE PRODUCTO_PJM SET STOCK = STOCK - det.CANTIDAD_PRODUCIDA WHERE ID_PRODUCTO = det.ID_PRODUCTO;
      FOR rec IN (SELECT ID_INSUMO, CANTIDAD FROM RECETA_PJM WHERE ID_PRODUCTO = det.ID_PRODUCTO AND ESTADO = 1) LOOP
        UPDATE PRODUCTO_PJM SET STOCK = STOCK + (rec.CANTIDAD * det.CANTIDAD_PRODUCIDA) WHERE ID_PRODUCTO = rec.ID_INSUMO;
      END LOOP;
      UPDATE DETALLE_PRODUCCION_PJM SET ESTADO = 0 WHERE ID_DETALLE_PRODUCCION = det.ID_DETALLE_PRODUCCION;
    END LOOP;
    UPDATE PRODUCCION_PJM SET ESTADO = 0 WHERE ID_PRODUCCION = P_ID_PRODUCCION;
    INSERT INTO AUDITORIA_PJM (ACCION, DESCRIPCION, USUARIO) VALUES ('PRODUCCION_CANCELADA', 'Se anuló la producción #' || P_ID_PRODUCCION, USER);
    COMMIT; ID_SALIDA := 1; MENSAJE := 'Producción anulada. Insumos y stock devueltos.';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END ANULAR_PRODUCCION_PJM;

  PROCEDURE GET_PRODUCCION_PJM(P_ID_PRODUCCION NUMBER, p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR SELECT ID_PRODUCCION, TO_CHAR(FECHA, 'DD/MM/YYYY') AS FECHA, TURNO, OBSERVACION, ESTADO FROM PRODUCCION_PJM WHERE ESTADO = 1 AND ID_PRODUCCION = NVL(P_ID_PRODUCCION, ID_PRODUCCION) ORDER BY ID_PRODUCCION DESC;
