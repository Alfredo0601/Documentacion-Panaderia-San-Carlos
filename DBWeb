  CREATE OR REPLACE NONEDITIONABLE PACKAGE BODY "SYSTEM"."PKG_INCIDENTES_PJM" AS

    PROCEDURE GET_INCIDENTES_PJM(
        p_fecha IN DATE,
        p_cur OUT SYS_REFCURSOR
    ) AS
    BEGIN
        OPEN p_cur FOR
            SELECT
                ID_INCIDENTE,
                RUTA,
                SUCURSAL,
                VENDEDOR,
                MOTIVO,
                DESCRIPCION,
                TO_CHAR(FECHA, 'DD/MM/YYYY HH24:MI') AS FECHA,
                ESTADO
            FROM INCIDENTES_RUTA_PJM
            WHERE p_fecha IS NULL
               OR TRUNC(FECHA) = TRUNC(p_fecha)
            ORDER BY ESTADO ASC, FECHA DESC;

    END GET_INCIDENTES_PJM;


    PROCEDURE INS_INCIDENTE_PJM(
        P_ID_PEDIDO NUMBER,
        P_RUTA VARCHAR2,
        P_SUCURSAL VARCHAR2,
        P_VENDEDOR VARCHAR2,
        P_MOTIVO VARCHAR2,
        P_DESCRIPCION VARCHAR2,
        ID_SALIDA OUT NUMBER,
        MENSAJE OUT VARCHAR2
    ) AS
        v_id NUMBER;
        v_estado PEDIDO_PJM.ESTADO%TYPE;
        v_ruta PEDIDO_PJM.RUTA%TYPE;
        v_vendedor PEDIDO_PJM.ENTREGADO_POR%TYPE;
        v_id_sucursal PEDIDO_PJM.ID_SUCURSAL%TYPE;
        v_sucursal SUCURSAL_PJM.NOMBRE%TYPE;

    BEGIN
        ID_SALIDA := -1;

        IF P_ID_PEDIDO IS NULL OR P_ID_PEDIDO <= 0 THEN
            MENSAJE := 'Seleccione un pedido válido.';
            RETURN;
        END IF;

        IF TRIM(P_MOTIVO) IS NULL THEN
            MENSAJE := 'Seleccione el motivo del incidente.';
            RETURN;
        END IF;

        -- Obtener y bloquear el pedido seleccionado.
        SELECT
            ESTADO,
            RUTA,
            ENTREGADO_POR,
            ID_SUCURSAL
        INTO
            v_estado,
            v_ruta,
            v_vendedor,
            v_id_sucursal
        FROM PEDIDO_PJM
        WHERE ID_PEDIDO = P_ID_PEDIDO
        FOR UPDATE;

        IF v_estado IS NULL OR v_estado <> 3 THEN
            ROLLBACK;
            MENSAJE := 'El pedido ya no está en ruta. Actualice la pantalla.';
            RETURN;
        END IF;

        SELECT NOMBRE
        INTO v_sucursal
        FROM SUCURSAL_PJM
        WHERE ID_SUCURSAL = v_id_sucursal;

        SELECT SQ_INCIDENTE_PJM.NEXTVAL
        INTO v_id
        FROM DUAL;

        -- Los datos de ruta, sucursal y vendedor se toman
        -- del pedido guardado en la base de datos.
        INSERT INTO INCIDENTES_RUTA_PJM (
            ID_INCIDENTE,
            RUTA,
            SUCURSAL,
            VENDEDOR,
            MOTIVO,
            DESCRIPCION,
            FECHA,
            ESTADO
        ) VALUES (
            v_id,
            v_ruta,
            v_sucursal,
            v_vendedor,
            P_MOTIVO,
            P_DESCRIPCION,
            SYSDATE - (6/24),
            'PENDIENTE'
        );

        -- Mantener la lógica actual de devolución de stock.
        FOR det IN (
            SELECT ID_PRODUCTO, CANTIDAD
            FROM DETALLE_PEDIDO_PJM
            WHERE ID_PEDIDO = P_ID_PEDIDO
              AND ESTADO = 1
            ORDER BY ID_PRODUCTO, ID_DETALLE_PEDIDO
            FOR UPDATE
        ) LOOP
            UPDATE PRODUCTO_PJM
            SET STOCK = STOCK + det.CANTIDAD
            WHERE ID_PRODUCTO = det.ID_PRODUCTO;
        END LOOP;

        -- Cancelar detalles y encabezado.
        UPDATE DETALLE_PEDIDO_PJM
        SET ESTADO = 0
        WHERE ID_PEDIDO = P_ID_PEDIDO;

        UPDATE PEDIDO_PJM
        SET ESTADO = 0
        WHERE ID_PEDIDO = P_ID_PEDIDO;

        INSERT INTO AUDITORIA_PJM (
            ACCION,
            DESCRIPCION,
            USUARIO
        ) VALUES (
            'PEDIDO_CANCELADO',
            'Pedido #' || P_ID_PEDIDO ||
            ' cancelado por incidente #' || v_id,
            USER
        );

        COMMIT;

        ID_SALIDA := v_id;
        MENSAJE := 'Incidente reportado. Pedido #' ||
                   P_ID_PEDIDO ||
                   ' cancelado y stock devuelto.';

    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            ROLLBACK;
            ID_SALIDA := -1;
            MENSAJE := 'No se encontró el pedido o su sucursal.';

        WHEN OTHERS THEN
            ROLLBACK;
            ID_SALIDA := -1;
            MENSAJE := 'Error: ' || SQLERRM;

    END INS_INCIDENTE_PJM;


    PROCEDURE RESOLVER_INCIDENTE_PJM(
        P_ID_INCIDENTE NUMBER,
        ID_SALIDA OUT NUMBER,
        MENSAJE OUT VARCHAR2
    ) AS
    BEGIN
        UPDATE INCIDENTES_RUTA_PJM
        SET ESTADO = 'RESUELTO'
        WHERE ID_INCIDENTE = P_ID_INCIDENTE
          AND ESTADO = 'PENDIENTE';

        IF SQL%ROWCOUNT = 0 THEN
            ROLLBACK;
            ID_SALIDA := -1;
            MENSAJE := 'El incidente no existe o ya está resuelto.';
            RETURN;
        END IF;

        COMMIT;

        ID_SALIDA := 1;
        MENSAJE := 'Incidente marcado como resuelto.';

    EXCEPTION
        WHEN OTHERS THEN
            ROLLBACK;
            ID_SALIDA := -1;
            MENSAJE := 'Error: ' || SQLERRM;

    END RESOLVER_INCIDENTE_PJM;

END PKG_INCIDENTES_PJM;

