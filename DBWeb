--  DDL for Package Body PKG_PANADERIA_PJM
--------------------------------------------------------

  CREATE OR REPLACE NONEDITIONABLE PACKAGE BODY "SYSTEM"."PKG_PANADERIA_PJM" AS

  -- SUCURSALES
  PROCEDURE GET_SUCURSALES_PJM(p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR SELECT ID_SUCURSAL, NOMBRE, DIRECCION, TELEFONO, RUTA, ESTADO FROM SUCURSAL_PJM WHERE ESTADO = 1 ORDER BY ID_SUCURSAL;
  END GET_SUCURSALES_PJM;

  PROCEDURE INS_SUCURSAL_PJM(P_NOMBRE VARCHAR2, P_DIRECCION VARCHAR2, P_TELEFONO VARCHAR2, P_RUTA VARCHAR2, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id NUMBER;
  BEGIN
    SELECT SQ_SUCURSAL_PJM.NEXTVAL INTO v_id FROM DUAL;
    INSERT INTO SUCURSAL_PJM VALUES (v_id, P_NOMBRE, P_DIRECCION, P_TELEFONO, P_RUTA, 1);
    COMMIT; ID_SALIDA := v_id; MENSAJE := 'Sucursal Ingresada Correctamente';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END INS_SUCURSAL_PJM;

  -- PRODUCTOS
  PROCEDURE GET_PRODUCTOS_PJM(p_tipo IN VARCHAR2, p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR
      SELECT ID_PRODUCTO, NOMBRE, CODIGO, TIPO, PRECIO, STOCK, STOCK_MINIMO, UNIDAD_MEDIDA, ESTADO
      FROM PRODUCTO_PJM WHERE ESTADO = 1 AND (p_tipo IS NULL OR TIPO = p_tipo) ORDER BY TIPO, NOMBRE;
  END GET_PRODUCTOS_PJM;

  PROCEDURE GET_PRODUCTO_PJM(p_id IN NUMBER, p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR SELECT ID_PRODUCTO, NOMBRE, CODIGO, TIPO, PRECIO, STOCK, STOCK_MINIMO, UNIDAD_MEDIDA, ESTADO FROM PRODUCTO_PJM WHERE ID_PRODUCTO = p_id AND ESTADO = 1;
  END GET_PRODUCTO_PJM;

  PROCEDURE INS_PRODUCTO_PJM(P_NOMBRE VARCHAR2, P_CODIGO VARCHAR2, P_TIPO VARCHAR2, P_PRECIO NUMBER, P_STOCK NUMBER, P_STOCK_MINIMO NUMBER, P_UNIDAD VARCHAR2, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id NUMBER;
  BEGIN
    IF P_STOCK < 0 THEN ID_SALIDA := -1; MENSAJE := 'El stock inicial no puede ser negativo'; RETURN; END IF;
    SELECT SQ_PRODUCTO_PJM.NEXTVAL INTO v_id FROM DUAL;
    INSERT INTO PRODUCTO_PJM VALUES (v_id, P_NOMBRE, P_CODIGO, P_TIPO, P_PRECIO, P_STOCK, P_STOCK_MINIMO, P_UNIDAD, 1);
    COMMIT; ID_SALIDA := v_id; MENSAJE := 'Producto Ingresado Correctamente';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END INS_PRODUCTO_PJM;

  -- RECETAS
  PROCEDURE GET_RECETA_PJM(p_id_producto IN NUMBER, p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR
      SELECT r.ID_RECETA, r.ID_PRODUCTO, p.NOMBRE AS PRODUCTO, r.ID_INSUMO, i.NOMBRE AS INSUMO, i.UNIDAD_MEDIDA, r.CANTIDAD, r.ESTADO
      FROM RECETA_PJM r JOIN PRODUCTO_PJM p ON p.ID_PRODUCTO = r.ID_PRODUCTO JOIN PRODUCTO_PJM i ON i.ID_PRODUCTO = r.ID_INSUMO
      WHERE r.ID_PRODUCTO = p_id_producto AND r.ESTADO = 1 ORDER BY r.ID_RECETA;
  END GET_RECETA_PJM;

  PROCEDURE INS_RECETA_PJM(P_ID_PRODUCTO NUMBER, P_ID_INSUMO NUMBER, P_CANTIDAD NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id NUMBER; v_count NUMBER;
  BEGIN
    SELECT COUNT(*) INTO v_count FROM RECETA_PJM WHERE ID_PRODUCTO = P_ID_PRODUCTO AND ID_INSUMO = P_ID_INSUMO;
    IF v_count > 0 THEN
      SELECT ID_RECETA INTO v_id FROM RECETA_PJM WHERE ID_PRODUCTO = P_ID_PRODUCTO AND ID_INSUMO = P_ID_INSUMO;
      UPDATE RECETA_PJM SET CANTIDAD = CANTIDAD + P_CANTIDAD, ESTADO = 1 WHERE ID_RECETA = v_id;
      COMMIT; ID_SALIDA := v_id; MENSAJE := 'Ingrediente actualizado. Cantidad sumada.';
    ELSE
      SELECT SQ_RECETA_PJM.NEXTVAL INTO v_id FROM DUAL;
      INSERT INTO RECETA_PJM VALUES (v_id, P_ID_PRODUCTO, P_ID_INSUMO, P_CANTIDAD, 1);
      COMMIT; ID_SALIDA := v_id; MENSAJE := 'Ingrediente agregado a la receta';
    END IF;
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END INS_RECETA_PJM;

  PROCEDURE DELETE_RECETA_PJM(P_ID_RECETA NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_count NUMBER;
  BEGIN
    SELECT COUNT(*) INTO v_count FROM RECETA_PJM WHERE ID_RECETA = P_ID_RECETA AND ESTADO = 1;
    IF v_count = 0 THEN ID_SALIDA := -1; MENSAJE := 'El ingrediente no existe o ya está eliminado'; RETURN; END IF;
    UPDATE RECETA_PJM SET ESTADO = 0 WHERE ID_RECETA = P_ID_RECETA;
    COMMIT; ID_SALIDA := 1; MENSAJE := 'Ingrediente eliminado de la receta';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END DELETE_RECETA_PJM;

  -- PEDIDOS
  PROCEDURE INS_PEDIDO_PJM(P_ID_SUCURSAL NUMBER, P_TURNO VARCHAR2, P_RUTA VARCHAR2, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id NUMBER;
  BEGIN
    SELECT SQ_PEDIDO_PJM.NEXTVAL INTO v_id FROM DUAL;
    INSERT INTO PEDIDO_PJM VALUES (v_id, P_ID_SUCURSAL, SYSDATE, P_TURNO, P_RUTA, 1);
    COMMIT; ID_SALIDA := v_id; MENSAJE := 'Pedido Ingresado Correctamente';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END INS_PEDIDO_PJM;

  PROCEDURE INS_DETALLE_PEDIDO_PJM(P_ID_PEDIDO NUMBER, P_ID_PRODUCTO NUMBER, P_CANTIDAD NUMBER, P_SUBTOTAL NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id NUMBER; v_stock NUMBER; v_nombre VARCHAR2(80);
  BEGIN
    SELECT STOCK, NOMBRE INTO v_stock, v_nombre FROM PRODUCTO_PJM WHERE ID_PRODUCTO = P_ID_PRODUCTO AND ESTADO = 1;
    IF v_stock < P_CANTIDAD THEN ID_SALIDA := -1; MENSAJE := 'No hay suficiente stock de ' || v_nombre; RETURN; END IF;
    SELECT SQ_DETALLE_PEDIDO_PJM.NEXTVAL INTO v_id FROM DUAL;
    INSERT INTO DETALLE_PEDIDO_PJM VALUES (v_id, P_ID_PEDIDO, P_ID_PRODUCTO, P_CANTIDAD, P_SUBTOTAL, 1);
    UPDATE PRODUCTO_PJM SET STOCK = STOCK - P_CANTIDAD WHERE ID_PRODUCTO = P_ID_PRODUCTO;
    COMMIT; ID_SALIDA := v_id; MENSAJE := 'Detalle agregado. Stock descontado.';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END INS_DETALLE_PEDIDO_PJM;

  PROCEDURE GET_PEDIDOS_PJM(P_ID_SUCURSAL NUMBER, P_ID_PEDIDO NUMBER, p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR
      SELECT p.ID_PEDIDO, s.NOMBRE AS SUCURSAL, TO_CHAR(p.FECHA, 'DD/MM/YYYY') AS FECHA, p.TURNO, p.RUTA, p.ESTADO
      FROM PEDIDO_PJM p JOIN SUCURSAL_PJM s ON s.ID_SUCURSAL = p.ID_SUCURSAL
      WHERE p.ESTADO IN (1, 2) AND s.ID_SUCURSAL = NVL(P_ID_SUCURSAL, s.ID_SUCURSAL) AND p.ID_PEDIDO = NVL(P_ID_PEDIDO, p.ID_PEDIDO)
      ORDER BY p.ID_PEDIDO DESC;
  END GET_PEDIDOS_PJM;

  PROCEDURE GET_DETALLE_PEDIDO_PJM(P_ID_PEDIDO NUMBER, p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR
      SELECT dp.ID_DETALLE_PEDIDO, dp.ID_PEDIDO, pr.ID_PRODUCTO, pr.NOMBRE AS PRODUCTO, pr.CODIGO, pr.PRECIO, dp.CANTIDAD, dp.SUBTOTAL, dp.ESTADO
      FROM DETALLE_PEDIDO_PJM dp JOIN PRODUCTO_PJM pr ON pr.ID_PRODUCTO = dp.ID_PRODUCTO
      WHERE dp.ID_PEDIDO = P_ID_PEDIDO AND dp.ESTADO = 1 ORDER BY dp.ID_DETALLE_PEDIDO;
  END GET_DETALLE_PEDIDO_PJM;

  PROCEDURE GET_TOTAL_PEDIDO_PJM(P_ID_PEDIDO NUMBER, P_TOTAL OUT NUMBER, MENSAJE OUT VARCHAR2) AS
  BEGIN
