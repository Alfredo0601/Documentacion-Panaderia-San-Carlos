  PROCEDURE ANULAR_DETALLE_PRODUCCION_PJM(P_ID_DETALLE_PRODUCCION NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id_producto NUMBER; v_cantidad NUMBER; v_count NUMBER;
  BEGIN
