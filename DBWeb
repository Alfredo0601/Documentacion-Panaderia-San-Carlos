    SELECT SQ_PRODUCCION_PJM.NEXTVAL INTO v_id FROM DUAL;
    INSERT INTO PRODUCCION_PJM VALUES (v_id, SYSDATE - (6/24), P_TURNO, P_OBSERVACION, 1);
