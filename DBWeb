    IF v_count = 0 THEN ID_SALIDA := -1; MENSAJE := 'El pedido no existe o ya está anulado/entregado'; RETURN; END IF;
    FOR det IN (SELECT ID_PRODUCTO, CANTIDAD FROM DETALLE_PEDIDO_PJM WHERE ID_PEDIDO = P_ID_PEDIDO AND ESTADO = 1) LOOP
      UPDATE PRODUCTO_PJM SET STOCK = STOCK + det.CANTIDAD WHERE ID_PRODUCTO = det.ID_PRODUCTO;
    END LOOP;
    UPDATE PEDIDO_PJM SET ESTADO = 0 WHERE ID_PEDIDO = P_ID_PEDIDO;
    UPDATE DETALLE_PEDIDO_PJM SET ESTADO = 0 WHERE ID_PEDIDO = P_ID_PEDIDO;
    COMMIT; ID_SALIDA := 1; MENSAJE := 'Pedido anulado. Stock devuelto.';
