   PROCEDURE GET_CLIENTES(p_cur_dataset OUT SYS_REFCURSOR)
   AS
   BEGIN
      OPEN p_cur_dataset FOR
         SELECT ID_CLIENTE, CLIENTE, NIT, ESTADO
         FROM CLIENTE_WEB
         WHERE ESTADO = 1
         ORDER BY ID_CLIENTE;
   END GET_CLIENTES;

   ---------------------------------------------------------
   PROCEDURE GET_PRODUCTOS(p_cur_dataset OUT SYS_REFCURSOR)
   AS
   BEGIN
      OPEN p_cur_dataset FOR
         SELECT ID_PRODUCTO, PRODUCTO, CODIGO, PRECIO, ESTADO
         FROM PRODUCTO
         WHERE ESTADO = 1
         ORDER BY ID_PRODUCTO;
   END GET_PRODUCTOS;

   ---------------------------------------------------------
   PROCEDURE INS_FACTURA(ID_CLIENTE NUMBER,
                         ID_SALIDA OUT NUMBER,
                         MENSAJE OUT VARCHAR2)
   AS
      v_id_factura NUMBER;
   BEGIN
      SELECT SQ_FACTURA.NEXTVAL INTO v_id_factura FROM DUAL;

      INSERT INTO FACTURA (ID_FACTURA, ID_CLIENTE, FECHA, ESTADO)
      VALUES (v_id_factura, ID_CLIENTE, SYSDATE, 1);

      COMMIT;

      ID_SALIDA := v_id_factura;
      MENSAJE   := 'Factura Ingresada Correctamente';
   EXCEPTION
      WHEN NO_DATA_FOUND THEN
         ID_SALIDA := -1;
         MENSAJE   := 'No fue posible obtener la secuencia para el id de la Factura';
      WHEN OTHERS THEN
         ROLLBACK;
         ID_SALIDA := -1;
         MENSAJE   := 'Excepción de base de datos: ' || SQLERRM;
   END INS_FACTURA;

   ---------------------------------------------------------
   PROCEDURE INS_DETALLE_FACTURA(ID_FACTURA NUMBER,
                                 ID_PRODUCTO NUMBER,
                                 CANTIDAD NUMBER,
                                 SUBTOTAL NUMBER,
                                 ID_SALIDA OUT NUMBER,
                                 MENSAJE OUT VARCHAR2)
   AS
      v_id_detalle_factura NUMBER;
   BEGIN
      SELECT SQ_DETALLE_FACTURA.NEXTVAL INTO v_id_detalle_factura FROM DUAL;

      INSERT INTO DETALLE_FACTURA
         (ID_DETALLE_FACTURA, ID_FACTURA, ID_PRODUCTO, CANTIDAD, SUBTOTAL, ESTADO)
      VALUES
         (v_id_detalle_factura, ID_FACTURA, ID_PRODUCTO, CANTIDAD, SUBTOTAL, 1);

      COMMIT;

      ID_SALIDA := v_id_detalle_factura;
      MENSAJE   := 'Detalle de Factura Ingresada Correctamente';
   EXCEPTION
      WHEN NO_DATA_FOUND THEN
         ID_SALIDA := -1;
         MENSAJE   := 'No fue posible obtener la secuencia para el id del detalle Factura';
      WHEN OTHERS THEN
         ROLLBACK;
         ID_SALIDA := -1;
         MENSAJE   := 'Excepción de base de datos: ' || SQLERRM;
   END INS_DETALLE_FACTURA;

   ---------------------------------------------------------
   PROCEDURE GET_ENCABEZADO_FACTURA(p_id_cliente NUMBER,
                                    p_id_factura NUMBER,
                                    p_cur_dataset OUT SYS_REFCURSOR)
   AS
   BEGIN
      OPEN p_cur_dataset FOR
         SELECT f.ID_FACTURA,
                TO_CHAR(f.FECHA, 'DD/MM/YYYY') AS FECHA,
                c.CLIENTE,
                c.NIT,
                f.ESTADO
         FROM FACTURA f
         JOIN CLIENTE_WEB c ON c.ID_CLIENTE = f.ID_CLIENTE
         WHERE f.ESTADO = 1
           AND c.ESTADO = 1
           AND c.ID_CLIENTE = NVL(p_id_cliente, c.ID_CLIENTE)
           AND f.ID_FACTURA = NVL(p_id_factura, f.ID_FACTURA)
         ORDER BY f.ID_FACTURA;
   END GET_ENCABEZADO_FACTURA;

   ---------------------------------------------------------
   PROCEDURE GET_DETALLE_FACTURA(p_id_factura NUMBER,
                                 p_cur_dataset OUT SYS_REFCURSOR)
   AS
   BEGIN
      OPEN p_cur_dataset FOR
         SELECT df.ID_DETALLE_FACTURA,
                df.ID_FACTURA,
                p.ID_PRODUCTO,
                p.PRODUCTO,
                p.CODIGO,
                p.PRECIO,
                df.CANTIDAD,
                df.SUBTOTAL,
                df.ESTADO
         FROM DETALLE_FACTURA df
         JOIN PRODUCTO p ON p.ID_PRODUCTO = df.ID_PRODUCTO
         WHERE df.ID_FACTURA = p_id_factura
           AND df.ESTADO = 1
           AND p.ESTADO  = 1
         ORDER BY df.ID_DETALLE_FACTURA;
   END GET_DETALLE_FACTURA;

   ---------------------------------------------------------
   PROCEDURE GET_TOTAL_FACTURA(p_id_factura NUMBER,
                               p_total OUT NUMBER,
                               MENSAJE OUT VARCHAR2)
   AS
   BEGIN
      SELECT NVL(SUM(SUBTOTAL), 0)
        INTO p_total
        FROM DETALLE_FACTURA
       WHERE ID_FACTURA = p_id_factura
         AND ESTADO = 1;

      MENSAJE := 'Total calculado correctamente';
   EXCEPTION
      WHEN OTHERS THEN
         p_total := 0;
         MENSAJE := 'Excepción de base de datos: ' || SQLERRM;
   END GET_TOTAL_FACTURA;

   ---------------------------------------------------------
   PROCEDURE ANULAR_FACTURA(p_id_factura NUMBER,
                            ID_SALIDA OUT NUMBER,
                            MENSAJE OUT VARCHAR2)
   AS
      v_count NUMBER;
   BEGIN
      SELECT COUNT(*) INTO v_count
        FROM FACTURA
       WHERE ID_FACTURA = p_id_factura;

      IF v_count = 0 THEN
         ID_SALIDA := -1;
         MENSAJE   := 'La factura no existe';
         RETURN;
      END IF;

      UPDATE FACTURA SET ESTADO = 0 WHERE ID_FACTURA = p_id_factura;
      UPDATE DETALLE_FACTURA SET ESTADO = 0 WHERE ID_FACTURA = p_id_factura;

      COMMIT;

      ID_SALIDA := 1;
      MENSAJE   := 'Factura anulada correctamente';
   EXCEPTION
      WHEN OTHERS THEN
         ROLLBACK;
         ID_SALIDA := -1;
         MENSAJE   := 'Excepción de base de datos: ' || SQLERRM;
   END ANULAR_FACTURA;

   ---------------------------------------------------------
   PROCEDURE ANULAR_DETALLE_FACTURA(p_id_detalle NUMBER,
                                    ID_SALIDA OUT NUMBER,
                                    MENSAJE OUT VARCHAR2)
   AS
      v_count NUMBER;
   BEGIN
      SELECT COUNT(*) INTO v_count
        FROM DETALLE_FACTURA
       WHERE ID_DETALLE_FACTURA = p_id_detalle;

      IF v_count = 0 THEN
         ID_SALIDA := -1;
         MENSAJE   := 'El detalle no existe';
         RETURN;
      END IF;

      UPDATE DETALLE_FACTURA SET ESTADO = 0 WHERE ID_DETALLE_FACTURA = p_id_detalle;

      COMMIT;

      ID_SALIDA := 1;
      MENSAJE   := 'Detalle anulado correctamente';
   EXCEPTION
      WHEN OTHERS THEN
         ROLLBACK;
         ID_SALIDA := -1;
         MENSAJE   := 'Excepción de base de datos: ' || SQLERRM;
   END ANULAR_DETALLE_FACTURA;

   ---------------------------------------------------------
   -- NUEVO: INSERTAR PRODUCTO
   ---------------------------------------------------------
   PROCEDURE INS_PRODUCTO(P_PRODUCTO VARCHAR2,
                          P_CODIGO   VARCHAR2,
                          P_PRECIO   NUMBER,
                          ID_SALIDA  OUT NUMBER,
                          MENSAJE    OUT VARCHAR2)
   AS
      v_id_producto NUMBER;
   BEGIN
      -- Generamos el ID con MAX+1 (no tienes secuencia para PRODUCTO)
      SELECT NVL(MAX(ID_PRODUCTO), 0) + 1
        INTO v_id_producto
        FROM PRODUCTO;

      INSERT INTO PRODUCTO (ID_PRODUCTO, PRODUCTO, CODIGO, PRECIO, ESTADO)
      VALUES (v_id_producto, P_PRODUCTO, P_CODIGO, P_PRECIO, 1);

      COMMIT;

      ID_SALIDA := v_id_producto;
      MENSAJE   := 'Producto Ingresado Correctamente';
   EXCEPTION
      WHEN OTHERS THEN
         ROLLBACK;
         ID_SALIDA := -1;
         MENSAJE   := 'Excepción de base de datos: ' || SQLERRM;
   END INS_PRODUCTO;

END PKG_FACTURA;

