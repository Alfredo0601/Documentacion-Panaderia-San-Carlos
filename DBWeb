    UPDATE PRODUCTO_PJM SET STOCK = STOCK - v_cantidad WHERE ID_PRODUCTO = v_id_producto;
    FOR rec IN (SELECT ID_INSUMO, CANTIDAD FROM RECETA_PJM WHERE ID_PRODUCTO = v_id_producto AND ESTADO = 1) LOOP
      UPDATE PRODUCTO_PJM SET STOCK = STOCK + (rec.CANTIDAD * v_cantidad) WHERE ID_PRODUCTO = rec.ID_INSUMO;
    END LOOP;
    UPDATE DETALLE_PRODUCCION_PJM SET ESTADO = 0 WHERE ID_DETALLE_PRODUCCION = P_ID_DETALLE_PRODUCCION;
    COMMIT; ID_SALIDA := 1; MENSAJE := 'Detalle anulado. Insumos devueltos.';
  EXCEPTION WHEN OTHERS THEN ROLLBACK; ID_SALIDA := -1; MENSAJE := 'Error: ' || SQLERRM;
  END ANULAR_DETALLE_PRODUCCION_PJM;

  PROCEDURE ANULAR_PRODUCCION_PJM(P_ID_PRODUCCION NUMBER, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
