  EXCEPTION WHEN OTHERS THEN p_total := 0; MENSAJE := 'Error'; END GET_PRODUCCION_ANULADA_PJM;

  -- ============================================================
  -- AUTO-REABASTECER (CON VALIDACIÓN DE INSUMOS)
  -- ============================================================
  PROCEDURE AUTO_REABASTECER_PJM(p_generados OUT NUMBER, p_mensaje OUT VARCHAR2) AS
    v_prod_id NUMBER;
    v_cantidad NUMBER := 50;
    v_hay_productos NUMBER := 0;
    v_nombres VARCHAR2(4000) := '';
    v_error_msg VARCHAR2(4000) := '';
    v_puede_producir BOOLEAN;
    v_falta VARCHAR2(200);
  BEGIN
    p_generados := 0;
    
    -- 1. Verificar si hay CUALQUIER producto con menos de 10 en stock
    SELECT COUNT(*) INTO v_hay_productos FROM PRODUCTO_PJM WHERE ESTADO=1 AND STOCK < 10;

    IF v_hay_productos = 0 THEN
        p_mensaje := 'No hay productos con stock bajo.';
        RETURN;
    END IF;

    -- 2. Crear encabezado de producción
    SELECT SQ_PRODUCCION_PJM.NEXTVAL INTO v_prod_id FROM DUAL;
    INSERT INTO PRODUCCION_PJM VALUES (v_prod_id, SYSDATE - (6/24), 'AUTO', 'Generación automática por stock bajo', 1);

    -- 3. Iterar sobre los productos (INSUMOS primero, luego FINALES)
    FOR prod IN (SELECT ID_PRODUCTO, NOMBRE, TIPO FROM PRODUCTO_PJM WHERE ESTADO=1 AND STOCK < 10 ORDER BY TIPO DESC) LOOP
        v_puede_producir := TRUE;
        v_falta := '';

        -- Si es un PAN (FINAL), verificar que haya insumos suficientes ANTES de producir
        IF prod.TIPO = 'FINAL' THEN
            FOR rec IN (
                SELECT i.NOMBRE, i.STOCK, r.CANTIDAD 
                FROM RECETA_PJM r 
                JOIN PRODUCTO_PJM i ON i.ID_PRODUCTO = r.ID_INSUMO 
                WHERE r.ID_PRODUCTO = prod.ID_PRODUCTO AND r.ESTADO = 1
            ) LOOP
                IF rec.STOCK < (rec.CANTIDAD * v_cantidad) THEN
                    v_puede_producir := FALSE;
                    v_falta := rec.NOMBRE || ' (necesita ' || (rec.CANTIDAD * v_cantidad) || ', hay ' || rec.STOCK || ')';
                    EXIT; -- Si falta uno, ya no se puede producir
                END IF;
            END LOOP;
        END IF;

        -- Si se puede producir (o es un insumo), se procesa
        IF v_puede_producir THEN
            INSERT INTO DETALLE_PRODUCCION_PJM VALUES (SQ_DETALLE_PRODUCCION_PJM.NEXTVAL, v_prod_id, prod.ID_PRODUCTO, v_cantidad, 1);
            UPDATE PRODUCTO_PJM SET STOCK = STOCK + v_cantidad WHERE ID_PRODUCTO = prod.ID_PRODUCTO;

            IF prod.TIPO = 'FINAL' THEN
                FOR rec IN (SELECT ID_INSUMO, CANTIDAD FROM RECETA_PJM WHERE ID_PRODUCTO = prod.ID_PRODUCTO AND ESTADO = 1) LOOP
                    UPDATE PRODUCTO_PJM SET STOCK = STOCK - (rec.CANTIDAD * v_cantidad) WHERE ID_PRODUCTO = rec.ID_INSUMO;
                END LOOP;
            END IF;

            v_nombres := v_nombres || prod.NOMBRE || ', ';
            p_generados := p_generados + 1;
        ELSE
            -- Si no hay insumos, guardamos el error pero continuamos con los demás
            v_error_msg := v_error_msg || prod.NOMBRE || ' (falta ' || v_falta || '). ';
        END IF;
    END LOOP;

    -- 4. Confirmar o revertir dependiendo de los resultados
    IF p_generados > 0 AND v_error_msg IS NULL THEN
        INSERT INTO AUDITORIA_PJM (ACCION, DESCRIPCION, USUARIO)
        VALUES ('AUTO_PRODUCCION', 'Se generaron ' || v_cantidad || ' unidades automáticas para: ' || v_nombres, 'SISTEMA');
        COMMIT;
        p_mensaje := 'Se generaron ' || v_cantidad || ' unidades para: ' || v_nombres;
    ELSIF p_generados > 0 AND v_error_msg IS NOT NULL THEN
        INSERT INTO AUDITORIA_PJM (ACCION, DESCRIPCION, USUARIO)
        VALUES ('AUTO_PRODUCCION', 'Se generaron ' || v_cantidad || ' unidades para: ' || v_nombres || '. No se pudo producir: ' || v_error_msg, 'SISTEMA');
        COMMIT;
        p_mensaje := 'Se generaron ' || v_cantidad || ' unidades para: ' || v_nombres || '. Pero: ' || v_error_msg;
    ELSIF p_generados = 0 AND v_error_msg IS NOT NULL THEN
        ROLLBACK;
        p_generados := -1;
        p_mensaje := 'No se pudo producir: ' || v_error_msg;
    ELSE
        ROLLBACK;
        p_mensaje := 'No se pudo generar producción automática.';
    END IF;

  EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        p_generados := -1;
        p_mensaje := 'Error: ' || SQLERRM;
  END AUTO_REABASTECER_PJM;

END PKG_PRODUCCION_PJM;

