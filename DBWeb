        UNION ALL
        SELECT 'Productos Finales', COUNT(*) FROM PRODUCTO_PJM WHERE TIPO = 'FINAL' AND ESTADO = 1
        UNION ALL
        SELECT 'Insumos', COUNT(*) FROM PRODUCTO_PJM WHERE TIPO = 'INSUMO' AND ESTADO = 1
        UNION ALL
        SELECT 'Pedidos Activos', COUNT(*) FROM PEDIDO_PJM WHERE ESTADO = 1
        UNION ALL
        SELECT 'Pedidos Entregados', COUNT(*) FROM PEDIDO_PJM WHERE ESTADO = 2
        UNION ALL
        SELECT 'Pedidos Cancelados', COUNT(*) FROM PEDIDO_PJM WHERE ESTADO = 0
        UNION ALL
        SELECT 'Producción Activa', COUNT(*) FROM PRODUCCION_PJM WHERE ESTADO = 1
        UNION ALL
