  CREATE OR REPLACE NONEDITIONABLE PACKAGE BODY "SYSTEM"."PKG_PRODUCCION_PJM" AS

  PROCEDURE INS_PRODUCCION_PJM(P_TURNO VARCHAR2, P_OBSERVACION VARCHAR2, ID_SALIDA OUT NUMBER, MENSAJE OUT VARCHAR2) AS
    v_id NUMBER;
