  CREATE OR REPLACE NONEDITIONABLE PACKAGE BODY "SYSTEM"."PKG_REPORTES_PJM" AS
    PROCEDURE GET_PEDIDOS_POR_SUCURSAL_PJM(P_ID_SUCURSAL NUMBER, P_FECHA DATE, p_cur OUT SYS_REFCURSOR) AS
  BEGIN
    OPEN p_cur FOR 
      SELECT p.ID_PEDIDO, 
             s.NOMBRE AS SUCURSAL, 
             TO_CHAR(p.FECHA, 'DD/MM/YYYY') AS FECHA, 
             p.TURNO, 
             pr.NOMBRE AS PRODUCTO, 
             dp.CANTIDAD, 
             dp.SUBTOTAL 
      FROM PEDIDO_PJM p 
      JOIN SUCURSAL_PJM s ON s.ID_SUCURSAL = p.ID_SUCURSAL 
      JOIN DETALLE_PEDIDO_PJM dp ON dp.ID_PEDIDO = p.ID_PEDIDO 
      JOIN PRODUCTO_PJM pr ON pr.ID_PRODUCTO = dp.ID_PRODUCTO 
      WHERE p.ESTADO IN (1, 2) -- <--- CAMBIO CLAVE: Muestra Activos y Entregados
        AND dp.ESTADO = 1 
        AND s.ID_SUCURSAL = NVL(P_ID_SUCURSAL, s.ID_SUCURSAL) 
        AND TRUNC(p.FECHA) = NVL(TRUNC(P_FECHA), TRUNC(p.FECHA)) 
      ORDER BY p.ID_PEDIDO, pr.NOMBRE;
